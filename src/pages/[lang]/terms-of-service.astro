---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalPage from '../../components/LegalPage.astro';
import { languagesList, legalMeta } from '../../i18n/ui';

export const prerender = true;

export function getStaticPaths() {
  return languagesList
    .filter((l) => l !== 'km')
    .map((lang) => ({ params: { lang } }));
}

const meta = legalMeta(Astro.url, 'terms');
---

<BaseLayout pageType="legal" title={meta.title} description={meta.description}>
  <LegalPage section="terms" />
</BaseLayout>
