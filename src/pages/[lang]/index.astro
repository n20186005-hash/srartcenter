---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBody from '../../components/PageBody.astro';
import { languagesList } from '../../i18n/ui';

export function getStaticPaths() {
  return languagesList
    .filter((l) => l !== 'km')
    .map((lang) => ({ params: { lang } }));
}
---

<BaseLayout>
  <PageBody />
</BaseLayout>
