---
import NearbyPage from '../../../components/NearbyPage.astro';
import { nearbySlugs } from '../../../data/nearby';
export const prerender = true;
export function getStaticPaths() { return ['en','zh'].flatMap((lang)=>nearbySlugs.map((slug)=>({ params:{ lang, slug } }))); }
const { lang, slug } = Astro.params;
---
<NearbyPage lang={lang} slug={slug} />
