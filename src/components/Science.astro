---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const s = messages.science;
---

<section id="science" class="anchor-offset mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-3xl font-bold text-brown">{s.title}</h2>
  <p class="mt-2 max-w-3xl text-brown/70">{s.intro}</p>

  <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {
      s.items.map((item: any) => (
        <article class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
          <span aria-hidden="true" class="grid h-11 w-11 place-items-center rounded-2xl bg-sand text-2xl">
            {item.icon}
          </span>
          <h3 class="mt-4 text-base font-bold text-brown">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-brown/75">{item.body}</p>
        </article>
      ))
    }
  </div>

  <div class="mt-12 rounded-3xl border border-brand/20 bg-sand/50 p-6 sm:p-8">
    <h3 class="text-xl font-bold text-brown">{s.etiquetteTitle}</h3>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-brown/75">{s.etiquetteIntro}</p>

    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        s.etiquette.map((item: any) => (
          <li class="rounded-2xl bg-white/80 p-5">
            <p class="text-sm font-bold text-brown">
              <span aria-hidden="true" class="mr-1">
                {item.icon}
              </span>
              {item.title}
            </p>
            <p class="mt-2 text-sm leading-relaxed text-brown/75">{item.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="mt-6 text-xs leading-relaxed text-brown/55">{s.note}</p>
  </div>
</section>
