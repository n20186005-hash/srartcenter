---
import { getI18n } from '../i18n/ui';
import { attraction, siteConfig } from '../config/site';

const { messages } = getI18n(Astro.url);
const s = messages.sources;
const year = new Date().getFullYear();
---

<section id="sources" class="anchor-offset mx-auto max-w-6xl px-4 py-14">
  <div class="rounded-3xl border border-black/5 bg-sand/50 p-6 shadow-sm sm:p-8">
    <h2 class="text-3xl font-bold text-brown">{s.title}</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-brown/70">{s.intro}</p>

    <dl class="mt-8 space-y-5">
      <!-- Reviews / rating source -->
      <div class="rounded-2xl border border-black/5 bg-white p-5">
        <dt class="text-sm font-semibold text-brown">
          {s.ratingLabel} · {s.syncedLabel} {s.syncedValue}
        </dt>
        <dd class="mt-2 text-sm leading-relaxed text-brown/70">
          <span class="font-semibold text-brown">{attraction.rating}</span>
          {' / '}
          <span>{attraction.reviewCountLabel}</span>
          {' — '}
          {s.ratingSourceNote}
        </dd>
        <dd class="mt-3">
          <a
            href={attraction.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold text-brand-dark underline decoration-brand/40 underline-offset-2 transition hover:text-brand"
          >
            {s.ratingLinkLabel} ↗
          </a>
        </dd>
      </div>

      <!-- Google Maps place listing -->
      <div class="rounded-2xl border border-black/5 bg-white p-5">
        <dt class="text-sm font-semibold text-brown">{s.mapsLabel}</dt>
        <dd class="mt-2 text-sm leading-relaxed text-brown/70">{s.mapsValue}</dd>
        <dd class="mt-3">
          <a
            href={attraction.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold text-brand-dark underline decoration-brand/40 underline-offset-2 transition hover:text-brand"
          >
            {s.mapsLinkLabel} ↗
          </a>
        </dd>
      </div>

      <!-- Official tourism portals -->
      <div class="rounded-2xl border border-black/5 bg-white p-5">
        <dt class="text-sm font-semibold text-brown">{s.govtLabel}</dt>
        <dd class="mt-2 text-sm leading-relaxed text-brown/70">
          {s.govtValue}. For official updates and regional tourism information, visit{' '}
          <a
            href={attraction.govtTourismUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-brand-dark underline decoration-brand/40 underline-offset-2 transition hover:text-brand"
          >
            {s.govtLinkLabel}
          </a>{' '}
          and the{' '}
          <a
            href={attraction.govtTourismOrgUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-brand-dark underline decoration-brand/40 underline-offset-2 transition hover:text-brand"
          >
            {s.govtOrgLinkLabel}
          </a>.
        </dd>
      </div>

      <!-- Public contact details -->
      <div class="rounded-2xl border border-black/5 bg-white p-5">
        <dt class="text-sm font-semibold text-brown">{s.contactLabel}</dt>
        <dd class="mt-2 text-sm leading-relaxed text-brown/70">
          <a href={`tel:${attraction.phone}`} class="font-medium hover:text-brand-dark">{attraction.phoneDisplay}</a>
          {' · '}
          <a
            href={attraction.website}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium underline decoration-brand/40 underline-offset-2 hover:text-brand-dark"
          >
            {siteConfig.brandDomain}
          </a>
        </dd>
      </div>

      <!-- Data sources used by the guide -->
      <div class="rounded-2xl border border-black/5 bg-white p-5">
        <dt class="text-sm font-semibold text-brown">{s.dataLabel}</dt>
        <dd class="mt-2 text-sm leading-relaxed text-brown/70">{s.dataValue}</dd>
        <dd class="mt-2 text-xs leading-relaxed text-brown/55">{s.dataNote}</dd>
      </div>

      <!-- Image ownership -->
      <div class="rounded-2xl border border-black/5 bg-white p-5">
        <dt class="text-sm font-semibold text-brown">{s.imagesLabel}</dt>
        <dd class="mt-2 text-sm leading-relaxed text-brown/70">{s.imagesValue}</dd>
        <dd class="mt-2 text-xs leading-relaxed text-brown/55">{s.imagesNote}</dd>
      </div>
    </dl>

    <p class="mt-6 text-xs leading-relaxed text-brown/55">{s.note}</p>
    <p class="mt-2 text-xs text-brown/45">
      {messages.footer.siteName} · {messages.breadcrumb.city} · {messages.breadcrumb.province} ·{' '}
      {messages.breadcrumb.country} · © {year}
    </p>
  </div>
</section>
