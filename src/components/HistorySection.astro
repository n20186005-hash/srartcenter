---
import { getI18n } from '../i18n/ui';
import { siteConfig } from '../config/site';

const { messages } = getI18n(Astro.url);
const h = messages.history;
---

<section id="history" class="anchor-offset mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-3xl font-bold text-brown">{h.title}</h2>

  <div class="mt-6 max-w-3xl space-y-4 text-base leading-relaxed text-brown/80">
    {h.paragraphs.map((p: string) => <p>{p}</p>)}
  </div>

  <!-- Chronology of the town the market belongs to -->
  <h3 class="mt-12 text-xl font-bold text-brown">{h.timelineTitle}</h3>
  <ol class="mt-5 space-y-5 border-l border-brand/25 pl-5">
    {
      h.timeline.map((entry: any) => (
        <li class="relative">
          <span class="absolute -left-[27px] top-1.5 grid h-3.5 w-3.5 place-items-center rounded-full bg-brand ring-4 ring-cream"></span>
          <p class="text-sm font-bold text-brand-dark">{entry.year}</p>
          <p class="text-base font-semibold text-brown">{entry.title}</p>
          <p class="mt-1 text-sm leading-relaxed text-brown/75">{entry.text}</p>
        </li>
      ))
    }
  </ol>

  <!-- Craft traditions represented on the stalls -->
  <h3 class="mt-12 text-xl font-bold text-brown">{h.craftsTitle}</h3>
  <p class="mt-2 max-w-3xl text-sm leading-relaxed text-brown/75">{h.craftsIntro}</p>
  <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      h.crafts.map((craft: any) => (
        <article class="rounded-2xl border border-black/5 bg-white p-5 shadow-sm">
          <span aria-hidden="true" class="text-2xl">
            {craft.icon}
          </span>
          <h4 class="mt-3 text-base font-bold text-brown">{craft.title}</h4>
          <p class="mt-2 text-sm leading-relaxed text-brown/70">{craft.body}</p>
        </article>
      ))
    }
  </div>

  <!-- Legends and local traditions, kept clearly apart from documented history -->
  <h3 class="mt-12 text-xl font-bold text-brown">{h.legendsTitle}</h3>
  <p class="mt-2 max-w-3xl text-sm leading-relaxed text-brown/75">{h.legendsIntro}</p>
  <div class="mt-5 grid gap-5 md:grid-cols-2">
    {
      h.legends.map((legend: any) => (
        <article class="rounded-2xl border border-black/5 bg-sand/50 p-6">
          <h4 class="text-base font-bold text-brown">
            <span aria-hidden="true" class="mr-1">
              {legend.icon}
            </span>
            {legend.title}
          </h4>
          <p class="mt-2 text-sm leading-relaxed text-brown/80">{legend.body}</p>
        </article>
      ))
    }
  </div>

  <p class="mt-8 text-xs text-brown/45">
    {siteConfig.domain} · {messages.footer.siteName}
  </p>
</section>
