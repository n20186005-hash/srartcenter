---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const o = messages.opening;
---

<section id="hours" class="anchor-offset mx-auto max-w-3xl px-4 py-14">
  <h2 class="text-3xl font-bold text-brown">{o.title}</h2>

  <div class="mt-8 overflow-hidden rounded-2xl border border-black/5 bg-white shadow-sm">
    <div class="flex items-center justify-between gap-4 border-b border-black/5 px-6 py-5">
      <div>
        <p class="text-sm text-brown/60">{o.daysLabel}</p>
        <p class="text-xl font-bold text-brown">{o.daysTime}</p>
      </div>
      <span class="inline-flex items-center rounded-full bg-sand px-3 py-1 text-sm font-semibold text-brand-dark">✓</span>
    </div>
    <div class="flex items-center justify-between gap-4 px-6 py-5">
      <div>
        <p class="text-sm text-brown/60">{o.sundayLabel}</p>
        <p class="text-xl font-bold text-brown">{o.sundayStatus}</p>
      </div>
      <span class="inline-flex items-center rounded-full bg-brown/10 px-3 py-1 text-sm font-semibold text-brown/70">✕</span>
    </div>
  </div>

  <p class="mt-4 text-sm text-brown/60">⚠️ {o.note}</p>
</section>
