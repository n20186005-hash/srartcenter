---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const fac = messages.facilities;
---

<section id="facilities" class="anchor-offset mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-3xl font-bold text-brown">{fac.title}</h2>
  <p class="mt-2 max-w-3xl text-sm leading-relaxed text-brown/75">{fac.intro}</p>

  <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {
      fac.cards.map((card: any) => (
        <article class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
          <span aria-hidden="true" class="grid h-12 w-12 place-items-center rounded-xl bg-sand text-2xl">
            {card.icon}
          </span>
          <h3 class="mt-4 text-lg font-bold text-brown">{card.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-brown/70">{card.body}</p>
        </article>
      ))
    }
  </div>

  <h3 class="mt-12 text-xl font-bold text-brown">{fac.nearby.title}</h3>
  <p class="mt-2 max-w-3xl text-sm leading-relaxed text-brown/70">{fac.nearby.intro}</p>

  <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      fac.nearby.items.map((item: any) => (
        <div class="rounded-2xl border border-black/5 bg-sand/60 p-5">
          <h4 class="text-base font-semibold text-brown">
            <span aria-hidden="true" class="mr-1">
              {item.icon}
            </span>
            {item.title}
          </h4>
          <p class="mt-2 text-sm leading-relaxed text-brown/70">{item.desc}</p>
        </div>
      ))
    }
  </div>

  <p class="mt-6 rounded-2xl border border-black/5 bg-white p-5 text-xs leading-relaxed text-brown/55">
    {fac.note}
  </p>
</section>
