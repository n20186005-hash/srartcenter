---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const a = messages.audiences;
---

<section id="audiences" class="anchor-offset mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-3xl font-bold text-brown">{a.title}</h2>
  <p class="mt-2 max-w-3xl text-brown/70">{a.intro}</p>

  <div class="mt-8 grid gap-5 lg:grid-cols-3">
    {
      a.plans.map((plan: any) => (
        <article class="flex flex-col rounded-3xl border border-black/5 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-3">
            <span aria-hidden="true" class="grid h-11 w-11 place-items-center rounded-2xl bg-sand text-2xl">
              {plan.icon}
            </span>
            <h3 class="text-lg font-bold text-brown">{plan.name}</h3>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-brown/80">{plan.summary}</p>

          <dl class="mt-5 space-y-2 text-sm">
            <div class="flex gap-2">
              <dt class="min-w-24 font-semibold text-brown/70">{a.labels.duration}</dt>
              <dd class="text-brown/85">{plan.duration}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="min-w-24 font-semibold text-brown/70">{a.labels.bestTime}</dt>
              <dd class="text-brown/85">{plan.bestTime}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="min-w-24 font-semibold text-brown/70">{a.labels.pace}</dt>
              <dd class="text-brown/85">{plan.pace}</dd>
            </div>
          </dl>

          <div class="mt-5">
            <h4 class="text-xs font-bold uppercase tracking-wide text-brown/60">{a.labels.stops}</h4>
            <ol class="mt-2 space-y-1.5 text-sm text-brown/80">
              {plan.stops.map((stop: string) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="text-brand">
                    →
                  </span>
                  <span>{stop}</span>
                </li>
              ))}
            </ol>
          </div>

          <div class="mt-5 rounded-2xl bg-sand/60 p-4">
            <h4 class="text-xs font-bold uppercase tracking-wide text-brown/60">{a.labels.bring}</h4>
            <p class="mt-2 text-sm leading-relaxed text-brown/80">{plan.bring}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
