---
import { getLangFromUrl, getI18n, langOrder, languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const { messages } = getI18n(Astro.url);

const navItems = [
  { key: 'overview', href: '#overview' },
  { key: 'about', href: '#about' },
  { key: 'experience', href: '#experience' },
  { key: 'hours', href: '#hours' },
  { key: 'markets', href: '#markets' },
  { key: 'weather', href: '#weather' },
  { key: 'transport', href: '#transport' },
  { key: 'faq', href: '#faq' },
];

const langHrefs: Record<string, string> = {
  km: '/',
  en: '/en/',
  zh: '/zh/',
};

const siteName = messages.header.siteName;
const isHome = ['/', '/en/', '/zh/'].includes(Astro.url.pathname);
const homeHref = langHrefs[lang];
const guideLabel: Record<string, string> = { km: 'មគ្គុទ្ទេសក៍', en: 'Guides', zh: '专题指南' };
const nearbyLabel: Record<string, string> = { km: 'ទីកន្លែងជិតខាង', en: 'Nearby', zh: '周边景点' };
const infoLabel: Record<string, string> = { km: 'ព័ត៌មានគេហទំព័រ', en: 'Site information', zh: '站点信息' };
const imageLabel: Record<string, string> = { km: 'ប្រភពរូបភាព', en: 'Image credits', zh: '图片版权' };
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-black/5 bg-cream/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href={langHrefs[lang]} class="flex items-center gap-2 font-bold text-brown">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand text-white">🏮</span>
      <span class="text-sm leading-tight sm:text-base">{siteName}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        navItems.map((item) => (
          <a
            href={isHome ? item.href : `${homeHref}${item.href}`}
            class="rounded-md px-2 py-2 text-sm font-medium text-brown/80 transition hover:bg-sand hover:text-brand-dark"
          >
            {messages.header.nav[item.key]}
          </a>
        ))
      }
      <a href={`${homeHref}#nearby`} class="rounded-md px-2 py-2 text-sm font-medium text-brown/80 transition hover:bg-sand hover:text-brand-dark">{nearbyLabel[lang]}</a>
      <a href={`${homeHref}#guides`} class="rounded-md px-2 py-2 text-sm font-medium text-brown/80 transition hover:bg-sand hover:text-brand-dark">{guideLabel[lang]}</a>
      <details class="group relative text-sm text-brown/80">
        <summary class="cursor-pointer list-none rounded-md px-2 py-2 font-medium hover:bg-sand hover:text-brand-dark">{infoLabel[lang]} ▾</summary>
        <div class="absolute right-0 top-full z-50 min-w-36 rounded-xl border border-black/10 bg-cream p-2 shadow-lg">
          <a class="block rounded-md px-3 py-2 hover:bg-sand" href={`${homeHref}reviews/`}>{messages.header.nav.reviews}</a>
          <a class="block rounded-md px-3 py-2 hover:bg-sand" href={`${homeHref}sources/`}>{messages.header.nav.sources}</a>
          <a class="block rounded-md px-3 py-2 hover:bg-sand" href={`${homeHref}image-credits/`}>{imageLabel[lang]}</a>
        </div>
      </details>
    </nav>

    <div class="flex items-center gap-1">
      <div class="flex items-center rounded-lg bg-sand p-1 text-sm font-medium">
        {
          langOrder.map((l) => (
            <a
              href={langHrefs[l]}
              class:list={[
                'rounded-md px-2 py-1 transition',
                l === lang ? 'bg-brand text-white' : 'text-brown/70 hover:text-brand-dark',
              ]}
              hreflang={l}
              aria-current={l === lang ? 'true' : undefined}
            >
              {languages[l]}
            </a>
          ))
        }
      </div>

      <button
        id="menu-toggle"
        class="ml-1 grid h-9 w-9 place-items-center rounded-lg text-brown hover:bg-sand md:hidden"
        aria-label="Menu"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-black/5 bg-cream md:hidden" aria-label="Mobile">
    <div class="mx-auto flex max-w-6xl flex-col px-4 py-2">
      {
        navItems.map((item) => (
          <a
            href={isHome ? item.href : `${homeHref}${item.href}`}
            class="rounded-md px-3 py-2 text-sm font-medium text-brown/80 hover:bg-sand hover:text-brand-dark"
          >
            {messages.header.nav[item.key]}
          </a>
        ))
      }
      <a href={`${homeHref}#nearby`} class="rounded-md px-3 py-2 text-sm font-medium text-brown/80 hover:bg-sand hover:text-brand-dark">{nearbyLabel[lang]}</a>
      <a href={`${homeHref}#guides`} class="rounded-md px-3 py-2 text-sm font-medium text-brown/80 hover:bg-sand hover:text-brand-dark">{guideLabel[lang]}</a>
      <a href={`${homeHref}reviews/`} class="rounded-md px-3 py-2 text-sm font-medium text-brown/80 hover:bg-sand">{messages.header.nav.reviews}</a>
      <a href={`${homeHref}sources/`} class="rounded-md px-3 py-2 text-sm font-medium text-brown/80 hover:bg-sand">{messages.header.nav.sources}</a>
      <a href={`${homeHref}image-credits/`} class="rounded-md px-3 py-2 text-sm font-medium text-brown/80 hover:bg-sand">{imageLabel[lang]}</a>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      var open = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    menu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  })();
</script>
