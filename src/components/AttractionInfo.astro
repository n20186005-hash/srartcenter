---
import { getI18n } from '../i18n/ui';
import { attraction, siteConfig } from '../config/site';
const { messages } = getI18n(Astro.url);
const info = messages.info;

const rows = [
  { label: info.labels.name, value: info.nameVal },
  { label: info.labels.type, value: info.typeVal },
  { label: info.labels.address, value: info.addressVal },
  { label: info.labels.coordinates, value: info.coordsVal },
  { label: info.labels.plusCode, value: info.plusCodeVal },
];
---

<section id="info" class="anchor-offset mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-3xl font-bold text-brown">{info.title}</h2>

  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      rows.map((row) => (
        <div class="rounded-2xl border border-black/5 bg-white p-5 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-wide text-brand-dark">{row.label}</p>
          <p class="mt-2 text-base font-medium text-brown">{row.value}</p>
        </div>
      ))
    }
    <div class="flex items-center rounded-2xl border border-black/5 bg-sand p-5 shadow-sm">
      <a
        href={attraction.mapsUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full bg-brand px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-dark"
      >
        🗺️ {info.mapCta}
      </a>
    </div>
  </div>
</section>
