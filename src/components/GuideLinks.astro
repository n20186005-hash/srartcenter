---
import { getLangFromUrl } from '../i18n/ui';
import { guideSlugs, guides } from '../data/guides';
const lang = getLangFromUrl(Astro.url);
const prefix = lang === 'km' ? '' : `/${lang}`;
const headings: Record<string, { title: string; intro: string; read: string }> = {
  en: { title: 'Plan your Siem Reap night-market visit', intro: 'Practical, focused guides for visiting the market, browsing crafts and exploring the riverfront.', read: 'Read guide' },
  zh: { title: '规划暹粒夜市之旅', intro: '从开放时间、手工艺购物到老市场河畔路线，按主题深入了解。', read: '阅读专题' },
  km: { title: 'រៀបចំដំណើរទៅផ្សាររាត្រីសៀមរាប', intro: 'មគ្គុទ្ទេសក៍អំពីម៉ោងបើក ការទិញសិប្បកម្ម និងការដើរលេងតាមមាត់ស្ទឹង។', read: 'អានមគ្គុទ្ទេសក៍' },
};
const t = headings[lang];
---
<section id="guides" class="anchor-offset mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-3xl font-bold text-brown">{t.title}</h2>
  <p class="mt-3 max-w-3xl leading-relaxed text-brown/70">{t.intro}</p>
  <div class="mt-8 grid gap-5 md:grid-cols-3">
    {guideSlugs.map((slug, i) => <article class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
      <span class="text-2xl" aria-hidden="true">{['🕒', '🎨', '🚶'][i]}</span>
      <h3 class="mt-4 text-lg font-bold leading-snug text-brown"><a href={`${prefix}/guides/${slug}/`} class="hover:text-brand-dark">{guides[lang][slug].title}</a></h3>
      <p class="mt-3 text-sm leading-relaxed text-brown/70">{guides[lang][slug].description}</p>
      <a href={`${prefix}/guides/${slug}/`} class="mt-5 inline-block text-sm font-bold text-brand-dark underline underline-offset-4">{t.read} →</a>
    </article>)}
  </div>
</section>
