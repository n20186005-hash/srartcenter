---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const safety = messages.safety;
---

<section id="safety" class="anchor-offset mx-auto max-w-6xl px-4 py-14">
  <div class="rounded-3xl border border-black/5 bg-white p-8 shadow-sm">
    <h2 class="text-3xl font-bold text-brown">{safety.title}</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        safety.items.map((item: any) => (
          <div class="flex items-start gap-3 rounded-2xl bg-sand/60 p-4">
            <span class="text-2xl">{item.icon}</span>
            <div>
              <h3 class="text-sm font-semibold text-brown">{item.title}</h3>
              <p class="mt-1 text-sm text-brown/70">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
