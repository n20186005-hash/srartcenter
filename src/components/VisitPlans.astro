---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const v = messages.visitPlans;

const plans = [v.halfDay, v.fullDay];
---

<section id="routes" class="anchor-offset mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-3xl font-bold text-brown">{v.title}</h2>
  <p class="mt-2 max-w-3xl text-brown/70">{v.intro}</p>

  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    {
      plans.map((plan: any, planIndex: number) => (
        <article class="rounded-3xl border border-black/5 bg-white p-6 shadow-sm sm:p-7">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="text-xl font-bold text-brown">
              <span aria-hidden="true" class="mr-1">
                {planIndex === 0 ? '🌆' : '🌇'}
              </span>
              {plan.label}
            </h3>
            <span class="rounded-full bg-sand px-3 py-1 text-xs font-semibold text-brand-dark">{plan.duration}</span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-brown/80">{plan.summary}</p>

          <ol class="mt-6 space-y-4 border-l border-brand/25 pl-5">
            {plan.steps.map((step: any) => (
              <li class="relative">
                <span class="absolute -left-[27px] top-1 grid h-3.5 w-3.5 place-items-center rounded-full bg-brand ring-4 ring-white"></span>
                <p class="text-sm font-bold text-brown">
                  <span class="rounded bg-sand px-1.5 py-0.5 text-xs font-semibold text-brand-dark">{step.time}</span>{' '}
                  {step.title}
                </p>
                <p class="mt-1 text-sm leading-relaxed text-brown/75">{step.desc}</p>
              </li>
            ))}
          </ol>

          <p class="mt-5 rounded-2xl bg-sand/60 p-4 text-sm leading-relaxed text-brown/80">{plan.note}</p>
        </article>
      ))
    }
  </div>

  <p class="mt-6 rounded-2xl border border-black/5 bg-sand/40 p-5 text-sm leading-relaxed text-brown/75">{v.ticketNote}</p>
</section>
