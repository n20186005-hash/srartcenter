---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const exp = messages.experience;
---

<section id="experience" class="anchor-offset mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-3xl font-bold text-brown">{exp.title}</h2>
  <p class="mt-2 max-w-2xl text-brown/70">{exp.intro}</p>

  <div class="mt-8 grid gap-5 md:grid-cols-3">
    {
      exp.items.map((item: any) => (
        <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm transition hover:shadow-md">
          <div class="grid h-12 w-12 place-items-center rounded-xl bg-sand text-2xl">{item.icon}</div>
          <h3 class="mt-4 text-lg font-bold text-brown">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-brown/70">{item.desc}</p>
          <ul class="mt-4 space-y-1.5 text-sm text-brown/80">
            {item.bullets.map((b: string) => (
              <li class="flex items-start gap-2">
                <span class="mt-1 text-brand">▪</span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
