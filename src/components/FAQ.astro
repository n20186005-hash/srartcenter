---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const faq = messages.faq;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((item: any) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<section id="faq" class="anchor-offset mx-auto max-w-3xl px-4 py-14">
  <h2 class="text-3xl font-bold text-brown">{faq.title}</h2>
  <div class="mt-8 space-y-3">
    {
      faq.items.map((item: any) => (
        <details class="group rounded-2xl border border-black/5 bg-white p-5 shadow-sm [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-brown">
            <span>{item.q}</span>
            <span class="ml-4 text-brand transition group-open:rotate-45">＋</span>
          </summary>
          <p class="mt-3 text-brown/70">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>

<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)}></script>
