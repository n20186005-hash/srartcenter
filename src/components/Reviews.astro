---
import { getI18n } from '../i18n/ui';
import { attraction } from '../config/site';

const { messages } = getI18n(Astro.url);
const r = messages.reviews;

// Aggregate rating is displayed on the page only — it is never emitted into
// JSON-LD. Source (Google Maps user reviews) is credited next to the values.
const rating = attraction.rating;
const fullStars = Math.floor(rating);
const hasHalfStar = rating - fullStars >= 0.25;
---

<section id="reviews" class="anchor-offset mx-auto max-w-6xl px-4 py-14">
  <div class="rounded-3xl border border-black/5 bg-white p-6 shadow-sm sm:p-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h2 class="text-3xl font-bold text-brown">{r.title}</h2>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-brown/70">{r.intro}</p>
      </div>
      <span class="rounded-full bg-sand px-3 py-1 text-xs font-semibold text-brand-dark">
        {r.sourceBadge}
      </span>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-black/5 bg-sand/50 p-5">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-dark">{r.ratingLabel}</p>
        <p class="mt-2 flex items-baseline gap-2" aria-label={`${r.ratingLabel}: ${r.ratingValue} ${r.ratingOutOf}`}>
          <span class="text-4xl font-extrabold text-brown">{r.ratingValue}</span>
          <span class="text-sm text-brown/60">{r.ratingOutOf}</span>
        </p>
        <p class="mt-2 text-lg leading-none text-gold" aria-hidden="true">
          {'★'.repeat(fullStars)}{hasHalfStar ? '☆' : ''}{'☆'.repeat(Math.max(0, 5 - fullStars - (hasHalfStar ? 1 : 0)))}
        </p>
      </div>

      <div class="rounded-2xl border border-black/5 bg-sand/50 p-5">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-dark">{r.reviewsLabel}</p>
        <p class="mt-2 text-4xl font-extrabold text-brown">{r.reviewCount}</p>
        <p class="mt-2 text-xs text-brown/60">{r.sourceBadge}</p>
      </div>

      <div class="rounded-2xl border border-black/5 bg-sand/50 p-5">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-dark">{r.categoryLabel}</p>
        <p class="mt-2 text-xl font-bold text-brown">{r.categoryValue}</p>
        <p class="mt-2 text-xs text-brown/60">{attraction.plusCode}</p>
      </div>
    </div>

    <p class="mt-6 text-xs leading-relaxed text-brown/60">
      {r.syncLinePrefix}{' '}
      <a
        href={attraction.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-brand-dark underline decoration-brand/40 underline-offset-2 transition hover:text-brand"
      >
        {r.syncLineLink}↗
      </a>
    </p>
    <p class="mt-2 text-xs leading-relaxed text-brown/60">{r.sourceNote}</p>

    <a
      href={attraction.mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-6 inline-flex items-center gap-2 rounded-full bg-brand px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-dark"
    >
      ⭐ {r.cta} ↗
    </a>

    <p class="mt-4 text-xs leading-relaxed text-brown/50">{r.dataNote}</p>
  </div>
</section>
