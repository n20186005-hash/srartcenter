---
import { getI18n } from '../i18n/ui';
import { attraction } from '../config/site';

const { messages } = getI18n(Astro.url);
const lm = messages.landmarks;
---

<section id="landmarks" class="anchor-offset mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-3xl font-bold text-brown">{lm.title}</h2>
  <p class="mt-2 max-w-2xl leading-relaxed text-brown/70">{lm.intro}</p>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      lm.items.map((item: any) => (
        <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
          <div class="grid h-12 w-12 place-items-center rounded-xl bg-sand text-2xl">{item.icon}</div>
          <h3 class="mt-4 text-base font-bold text-brown">{item.name}</h3>
          <p class="mt-2 text-sm leading-relaxed text-brown/70">{item.desc}</p>
          <p class="mt-3 text-xs text-brown/45">
            {item.name} · {lm.imageAlt}
          </p>
        </div>
      ))
    }
  </div>

  <p class="mt-6 text-xs leading-relaxed text-brown/50">
    {messages.entity.cluster}
  </p>
</section>
