---
import BaseLayout from '../layouts/BaseLayout.astro';
import { guides, guideSlugs, type GuideSlug } from '../data/guides';
import { attraction, siteConfig } from '../config/site';
const { lang, slug } = Astro.props as { lang: string; slug: GuideSlug };
const guide = guides[lang][slug];
const prefix = lang === 'km' ? '' : `/${lang}`;
const copy: Record<string, { home: string; guide: string; checklist: string; other: string; map: string; verify: string; sources: string }> = {
  en: { home: 'Home', guide: 'In-depth visitor guides', checklist: 'Before you go', other: 'Explore more guides', map: 'Open the exact market location', verify: 'Opening hours and stall arrangements can change. Check on site before your visit.', sources: 'Location and visitor information sources' },
  zh: { home: '首页', guide: '深度游览专题', checklist: '出发前清单', other: '更多专题', map: '查看夜市专属地图定位', verify: '营业时间和摊位安排可能变动，出行前请在现场核实。', sources: '位置与游览信息参考' },
  km: { home: 'ទំព័រដើម', guide: 'មគ្គុទ្ទេសក៍លម្អិត', checklist: 'មុនចេញដំណើរ', other: 'អានបន្ថែម', map: 'បើកទីតាំងផ្សារលើផែនទី', verify: 'ម៉ោងបើក និងការរៀបចំតូបអាចផ្លាស់ប្តូរ។ សូមពិនិត្យនៅទីតាំងជាក់ស្តែង។', sources: 'ប្រភពព័ត៌មានទីតាំង និងការទស្សនា' },
};
const t = copy[lang];
---
<BaseLayout title={`${guide.title} | Siem Reap Art Center Night Market`} description={guide.description} pageType="guide">
  <main class="mx-auto max-w-5xl px-4 pb-16 pt-28 text-brown">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-brown/65">
      <a class="hover:text-brand" href={`${prefix}/`}>{t.home}</a><span aria-hidden="true"> / </span><span>{t.guide}</span>
    </nav>
    <header class="rounded-3xl bg-sand px-6 py-10 sm:px-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand-dark">{t.guide}</p>
      <h1 class="max-w-4xl text-3xl font-bold leading-tight sm:text-4xl">{guide.title}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-brown/80">{guide.intro}</p>
      <a class="mt-6 inline-flex rounded-full bg-brand px-5 py-3 font-semibold text-white hover:bg-brand-dark" href={attraction.mapsUrl} target="_blank" rel="noopener noreferrer">🗺️ {t.map} ↗</a>
    </header>
    <figure class="mt-8 overflow-hidden rounded-2xl bg-sand">
      <img src={`/gallery/${siteConfig.slug}-2.webp`} alt={lang === 'zh' ? '暹粒艺术中心夜市现有实景照片' : lang === 'km' ? 'រូបភាពផ្សាររាត្រី Art Center សៀមរាប' : 'Existing photograph of Siem Reap Art Center Night Market'} loading="lazy" width="1200" height="800" class="max-h-[420px] w-full object-cover" />
    </figure>
    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_260px]">
      <article class="space-y-10">
        {guide.sections.map((section) => <section>
          <h2 class="mb-4 text-2xl font-bold">{section.heading}</h2>
          {section.paragraphs.map((p) => <p class="mb-4 leading-8 text-brown/80">{p}</p>)}
        </section>)}
        <section class="rounded-2xl border border-black/5 bg-white p-6">
          <h2 class="mb-4 text-xl font-bold">{t.checklist}</h2>
          <ul class="list-disc space-y-3 pl-5 leading-relaxed text-brown/80">{guide.tips.map((tip) => <li>{tip}</li>)}</ul>
          <p class="mt-6 text-sm text-brown/60">{t.verify}</p>
        </section>
        <section class="text-sm leading-7 text-brown/70">
          <h2 class="mb-2 text-lg font-bold text-brown">{t.sources}</h2>
          <ul class="list-disc pl-5">
            <li><a class="underline" href={attraction.mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps — Siem Reap Art Center Night Market</a></li>
            <li><a class="underline" href="https://www.siemreap.net/attractions/shopping/souvenir-night-markets/" target="_blank" rel="noopener noreferrer">SiemReap.net — Souvenir & Night Markets</a></li>
            <li><a class="underline" href="https://tourism.gov.kh/en/" target="_blank" rel="noopener noreferrer">Cambodia Ministry of Tourism</a></li>
          </ul>
        </section>
      </article>
      <aside class="self-start rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-bold">{t.other}</h2>
        <ul class="mt-4 space-y-4">{guideSlugs.filter((s) => s !== slug).map((s) => <li><a class="font-medium leading-relaxed text-brand-dark underline decoration-brand/30 underline-offset-4 hover:decoration-brand" href={`${prefix}/guides/${s}/`}>{guides[lang][s].title}</a></li>)}</ul>
        <a class="mt-6 block border-t border-black/10 pt-4 text-sm font-medium text-brand-dark" href={`${prefix}/`}>← {t.home}</a>
      </aside>
    </div>
  </main>
</BaseLayout>
